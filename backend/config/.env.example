# Copy to .env in this folder (backend loads config/.env — see backend/index.js).
# Never commit .env or real connection strings.

MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE

PORT=5000
SECRET_KEY=replace-with-a-long-random-string

GROQ_API_KEY=
# Optional; defaults to llama-3.3-70b-versatile in code
GROQ_MODEL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=
SMTP_PORT=
